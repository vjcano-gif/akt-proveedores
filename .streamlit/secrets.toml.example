# Copie a .streamlit/secrets.toml y complete con sus datos de Supabase.
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4)
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:SU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Opcional pero recomendado: evidencias en Supabase Storage.
# Project Settings -> API
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "su-service-role-key"
SUPABASE_STORAGE_BUCKET = "akt-documentos"
