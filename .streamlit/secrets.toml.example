# Copie a .streamlit/secrets.toml y complete con sus datos de Supabase.
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4)
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:SU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"


# Reconocimiento documental multimodal (opcional; Gemini 2.5 Flash-Lite tiene nivel gratuito).
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash-lite"

# Evidencias en Supabase Storage (opcional; si falta, usa fallback en BD).
SUPABASE_URL = ""
SUPABASE_SERVICE_ROLE_KEY = ""
SUPABASE_STORAGE_BUCKET = "documentos-akt"


# Primer usuario productivo (solo se usa si la tabla usuarios está vacía).
BOOTSTRAP_ADMIN_EMAIL = "admin@empresa.com"
BOOTSTRAP_ADMIN_PASSWORD = "CAMBIE-ESTA-CLAVE-MINIMO-12"
BOOTSTRAP_ADMIN_NAME = "Administrador Inventarios"
