# Copie a .streamlit/secrets.toml y complete con sus datos de Supabase.
# Supabase -> Connect -> Session pooler (IPv4), puerto 5432.
# En Streamlit Cloud se prioriza DATABASE_URL_POOLER. DATABASE_URL queda como
# compatibilidad para instalaciones antiguas.
DATABASE_URL_POOLER = "postgresql://postgres.xxxxxxxxxxxx:SU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# DATABASE_URL = "postgresql://..."

# Opcional pero recomendado: evidencias en Supabase Storage.
# Project Settings -> API
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "su-service-role-key"
SUPABASE_STORAGE_BUCKET = "akt-documentos"

# Seguridad de arranque
# En producción mantenga DEMO_MODE = false.
DEMO_MODE = false
BOOTSTRAP_ADMIN_EMAIL = "admin@suempresa.com"
BOOTSTRAP_ADMIN_PASSWORD = "CAMBIE-ESTA-CLAVE-DE-AL-MENOS-12-CARACTERES"
BOOTSTRAP_ADMIN_NAME = "Administrador inicial"


# IA documental — Gemini (recomendado para fotos BIN)
# Cree una API key en Google AI Studio y agréguela también en Streamlit Cloud > Secrets.
GEMINI_API_KEY = "su-gemini-api-key"
GEMINI_VISION_MODEL = "gemini-3.8-flash"

# Motores alternativos opcionales
# OPENAI_API_KEY = "..."
# MISTRAL_API_KEY = "..."
